{
    "type": "project",
    "name": "sample/application",
    "description": "",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "8.3.* || 8.4.*",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-igbinary": "*",
        "ext-intl": "*",
        "ext-redis": "*",
        "ext-timezonedb": "*",
        "doctrine/dbal": "^4.4.1",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/orm": "^3.6.1",
        "doctrine/instantiator": "^2.0.0",
        "phpdocumentor/reflection-docblock": "^6.0.0",
        "phpstan/phpdoc-parser": "^2.3.1",
        "symfony/amqp-messenger": "^7.4.3",
        "symfony/console": "^7.4.3",
        "symfony/dotenv": "^7.4",
        "symfony/flex": "^2.10",
        "symfony/property-access": "^7.4.3",
        "symfony/property-info": "^7.4.3",
        "symfony/runtime": "^7.4.1",
        "symfony/serializer": "^7.4.3",
        "symfony/yaml": "^7.4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.6",
        "psalm/plugin-symfony": "^5.2.8",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^7.4.3",
        "symfony/phpunit-bridge": "^7.4.3",
        "vimeo/psalm": "^6.14.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "version": "1.0.45"
}
